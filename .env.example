# Optional local config overrides. Docker Compose defaults to the committed
# development-only secret files under docker/secrets/dev/.

# Shared runtime configuration
DBT_TARGET=local_clickhouse
OLIST_AIRFLOW_RETRIES=2
OLIST_AIRFLOW_RETRY_DELAY_SECONDS=300

# ClickHouse serving/analytics warehouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=olist
CLICKHOUSE_DATABASE=serving_cdc
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=19000
CLICKHOUSE_SECURE=false

# PostgreSQL platform/control plane (not the analytical warehouse)
PLATFORM_POSTGRES_HOST_PORT=5432
CONTROL_POSTGRES_HOST=localhost
CONTROL_POSTGRES_PORT=5432
CONTROL_POSTGRES_DB=olist_control
CONTROL_POSTGRES_USER=olist_control

# MySQL OLTP source and local service ports
MYSQL_HOST_PORT=3306
KAFKA_HOST_PORT=9092
KAFKA_CONNECT_HOST_PORT=8083
APICURIO_HOST_PORT=8081
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SPARK_MASTER_HOST_PORT=7077
SPARK_MASTER_WEB_HOST_PORT=8082
POLARIS_HOST_PORT=8181
AIRFLOW_HOST_PORT=8080

# Optional observability ports
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100
ALERTMANAGER_HOST_PORT=9093
ALLOY_HOST_PORT=12345
TARGET_PROBE_HOST_PORT=9108
KAFKA_EXPORTER_HOST_PORT=9308

# Point Compose at different secret files without editing compose.yaml.
# *_SOURCE_FILE values are paths on the host running Docker Compose.
# AIRFLOW_POSTGRES_PASSWORD_SOURCE_FILE=.secrets/airflow_postgres_password.txt
# CONTROL_POSTGRES_PASSWORD_SOURCE_FILE=.secrets/control_postgres_password.txt
# POLARIS_DB_USERNAME_SOURCE_FILE=.secrets/polaris_db_user.txt
# POLARIS_DB_PASSWORD_SOURCE_FILE=.secrets/polaris_db_password.txt
# APICURIO_DB_USERNAME_SOURCE_FILE=.secrets/apicurio_db_user.txt
# APICURIO_DB_PASSWORD_SOURCE_FILE=.secrets/apicurio_db_password.txt
# MYSQL_ROOT_PASSWORD_SOURCE_FILE=.secrets/mysql_root_password.txt
# MYSQL_ADMIN_PASSWORD_SOURCE_FILE=.secrets/mysql_admin_password.txt
# MYSQL_SIMULATOR_PASSWORD_SOURCE_FILE=.secrets/mysql_simulator_password.txt
# MYSQL_CDC_READER_PASSWORD_SOURCE_FILE=.secrets/mysql_cdc_reader_password.txt
# MYSQL_REFERENCE_READER_PASSWORD_SOURCE_FILE=.secrets/mysql_spark_reference_reader_password.txt
# MINIO_ROOT_USER_SOURCE_FILE=.secrets/minio_root_user.txt
# MINIO_ROOT_PASSWORD_SOURCE_FILE=.secrets/minio_root_password.txt
# CLICKHOUSE_PASSWORD_SOURCE_FILE=.secrets/clickhouse_password.txt
# AIRFLOW_API_SECRET_KEY_SOURCE_FILE=.secrets/airflow_api_secret_key.txt
