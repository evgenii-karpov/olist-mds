{
  "contract_version": 1,
  "security_model": "one-dedicated-volume-per-consumer",
  "consumers": {
    "polaris-admin": {
      "files": [
        {
          "source": "bootstrap-admin-client-id",
          "environment": "POLARIS_ROOT_CLIENT_ID_FILE"
        },
        {
          "source": "bootstrap-admin-client-secret",
          "environment": "POLARIS_ROOT_CLIENT_SECRET_FILE"
        }
      ]
    },
    "polaris-server": {
      "files": [
        {
          "source": "bootstrap-admin-client-id",
          "environment": "POLARIS_ROOT_CLIENT_ID_FILE"
        },
        {
          "source": "bootstrap-admin-client-secret",
          "environment": "POLARIS_ROOT_CLIENT_SECRET_FILE"
        },
        {
          "source": "minio-polaris-access-key",
          "environment": "POLARIS_WAREHOUSE_ACCESS_KEY_FILE"
        },
        {
          "source": "minio-polaris-secret-key",
          "environment": "POLARIS_WAREHOUSE_SECRET_KEY_FILE"
        }
      ]
    },
    "spark": {
      "files": [
        {
          "source": "polaris-spark-client-id",
          "environment": "POLARIS_SPARK_CLIENT_ID_FILE"
        },
        {
          "source": "polaris-spark-client-secret",
          "environment": "POLARIS_SPARK_CLIENT_SECRET_FILE"
        },
        {
          "source": "minio-checkpoints-access-key",
          "environment": "OBJECT_STORE_ACCESS_KEY_FILE"
        },
        {
          "source": "minio-checkpoints-secret-key",
          "environment": "OBJECT_STORE_SECRET_KEY_FILE"
        }
      ]
    },
    "clickhouse": {
      "files": [
        {
          "source": "polaris-clickhouse-client-id",
          "environment": "POLARIS_PRINCIPAL_ID_FILE"
        },
        {
          "source": "polaris-clickhouse-client-secret",
          "environment": "POLARIS_PRINCIPAL_SECRET_FILE"
        }
      ]
    },
    "airflow": {
      "files": [
        {
          "source": "polaris-airflow-client-id",
          "environment": "POLARIS_AIRFLOW_CLIENT_ID_FILE"
        },
        {
          "source": "polaris-airflow-client-secret",
          "environment": "POLARIS_AIRFLOW_CLIENT_SECRET_FILE"
        }
      ]
    }
  }
}
