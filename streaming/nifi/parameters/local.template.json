{
  "flow_version": "olist-cdc-v1",
  "kafka_bootstrap_servers": "kafka:29092",
  "kafka_group_id": "olist-nifi-cdc-v1",
  "registry_url": "http://apicurio-registry:8080",
  "minio_endpoint": "http://minio:9000",
  "minio_region": "us-east-1",
  "minio_bucket": "olist-cdc",
  "minio_access_key": "olist_nifi",
  "minio_secret_file": "/run/secrets/minio_nifi_password",
  "schema_directory": "/opt/olist/schemas",
  "default_scheduling_period": "0 sec",
  "default_concurrent_tasks": 4,
  "processor_concurrent_tasks": {
    "Consume Olist CDC": 2,
    "Route Tombstones": 8,
    "Build Landing Avro": 8,
    "Build Normalized Avro": 8,
    "Merge Landing Micro-batch": 4,
    "Merge Normalized Micro-batch": 4,
    "Merge Landing": 4,
    "Merge Normalized": 4,
    "Describe Landing Batch": 4,
    "Describe Normalized Batch": 4,
    "Convert Normalized to Parquet": 4,
    "Put Landing Immutable": 6,
    "Put Normalized Immutable": 6,
    "Put Quarantine Immutable": 2,
    "Publish Table DLQ": 2
  },
  "max_bin_age": "45 sec",
  "minimum_bin_size": "32 MB",
  "maximum_bin_size": "64 MB",
  "backpressure_object_threshold": 20000,
  "backpressure_data_size_threshold": "1 GB"
}
